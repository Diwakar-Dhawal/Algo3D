# --- database ---------------------------------------------------------------
# Neon Postgres connection string (Project → Connect → Connection string).
# Server-side only: the browser never sees it.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Clerk ------------------------------------------------------------------
# Clerk Dashboard → your application → API keys.
# The publishable key is public and safe to ship to the browser. It is also
# served at runtime by /api/config, so a deploy only needs it in the server
# environment (Vercel → Settings → Environment Variables) — no rebuild required
# when it changes. CLERK_PUBLISHABLE_KEY is accepted as the same value.
# The secret key is server-only: put it in Vercel → Settings → Environment
# Variables (and in .env.local for local API work). Never commit it.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_Ym9zcy1mbHktMzk0MC5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_KJHFVit8qPzuaJUCh7zZxKWlwn7J403PyGMetS5Q1Z

# --- optional ---------------------------------------------------------------
# Set this once the app has a fixed production origin: Clerk session tokens are
# then only accepted when they were minted for it.
APP_ORIGIN=
